# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# macOS files
.DS_Store

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# Version-specific project R package library
.r-library/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Project documentation under docs/ is tracked. Configure any future pkgdown
# site to use a separate generated-output directory.

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Project-specific
# Output files (generated by analysis)
output/*.rds
output/*.csv
output/pre_unit_model_promotion/
output/part1/
output/part2/
output/part3/

# targets metadata and object store
_targets/

# Figures (generated visualizations)
figures/*.png
figures/*.html
figures/*.pdf
figures/*_files/

# Data files (user-provided, may contain sensitive info)
data/*.csv
data/*.xlsx
data/*.shp
data/*.geojson
data/raw_parcels/
data/raw_amenities/
data/raw_acs/
data/raw_311/

# Keep directory structure
!output/.gitkeep
!figures/.gitkeep
!data/.gitkeep
!data/README.md
